{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lakeland-fine-arts-beta",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./src/Lakeland.OrderFulfilment.Api/wwwroot",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health", "/contact", "/gallery", "/products", "/cart", "/checkout/success"]
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
