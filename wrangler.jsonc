{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lakeland-fine-arts-beta",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "send_email": [
    { "name": "CONTACT_EMAIL", "destination_address": "contact-form@lakelandfinearts.com" }
  ],
  "ratelimits": [
    { "name": "CONTACT_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    { "name": "CONTACT_GLOBAL_LIMIT", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ],
  "assets": {
    "directory": "./src/Lakeland.OrderFulfilment.Api/wwwroot",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health", "/contact", "/gallery", "/products", "/cart", "/checkout/success"]
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
